local TagEnabled = true
local VipRainbowConnection = nil
local ActiveTags = {}

local function removeTag(plr)
    if plr and plr.Character then
        local t = plr.Character:FindFirstChild("NameTag")
        if t then
            t:Destroy()
            ActiveTags[plr.UserId] = nil
        end
    end
end

local function createTag(plr)
    if not TagEnabled or not plr or not plr.Character or ActiveTags[plr.UserId] then return end

    local head = plr.Character:FindFirstChild("Head")
    if not head then return end

    removeTag(plr)

    local role = "عضو"
    if Owners[plr.Name] then
        role = "مطور"
    elseif Admins[plr.Name] then
        role = "VIP"
    end

    local gui = Instance.new("BillboardGui")
    gui.Name = "NameTag"
    gui.Adornee = head
    gui.Parent = plr.Character
    gui.Size = UDim2.new(4, 0, 1.5, 0)
    gui.StudsOffset = Vector3.new(0, 3.5, 0)
    gui.AlwaysOnTop = true

    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local gradient = Instance.new("UIGradient", frame)
    gradient.Rotation = 90

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 2

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = role
    
    if role == "مطور" then
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(152, 251, 152)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
        }
        stroke.Color = Color3.fromRGB(46, 204, 113)
        stroke.Thickness = 3
        label.TextColor3 = Color3.fromRGB(46, 204, 113)
    elseif role == "VIP" then
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
        }
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local rainbowColors = {
            Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 255, 0),
            Color3.fromRGB(0, 255, 255), Color3.fromRGB(0, 0, 255), Color3.fromRGB(255, 0, 255),
            Color3.fromRGB(255, 165, 0), Color3.fromRGB(255, 20, 147)
        }
        
        local index = 1
        if VipRainbowConnection then
            VipRainbowConnection:Disconnect()
            VipRainbowConnection = nil
        end
        
        VipRainbowConnection = RunService.Heartbeat:Connect(function()
            if not TagEnabled then
                if VipRainbowConnection then
                    VipRainbowConnection:Disconnect()
                    VipRainbowConnection = nil
                end
                return
            end
            if stroke and stroke.Parent then
                stroke.Color = rainbowColors[index]
                index = (index % #rainbowColors) + 1
            end
            task.wait(0.5)
        end)
    else
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 0, 0))
        }
        stroke.Color = Color3.fromRGB(0, 0, 0)
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    ActiveTags[plr.UserId] = true
end

local function updateAllTags()
    for _, plr in ipairs(Players:GetPlayers()) do
        createTag(plr)
    end
end

InfoTab:AddToggle({
    Name = "إظهار الرتب فوق اللاعبين",
    Default = true,
    Callback = function(state)
        TagEnabled = state
        if state then
            updateAllTags()
        else
            if VipRainbowConnection then
                VipRainbowConnection:Disconnect()
                VipRainbowConnection = nil
            end
            for _, plr in ipairs(Players:GetPlayers()) do
                removeTag(plr)
            end
            ActiveTags = {}
        end
    end
})

for _, plr in ipairs(Players:GetPlayers()) do
    createTag(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if TagEnabled then createTag(plr) end
    end)
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if TagEnabled then createTag(plr) end
    end)
    task.wait(0.5)
    createTag(plr)
end)

Players.PlayerRemoving:Connect(function(plr)
    removeTag(plr)
    ActiveTags[plr.UserId] = nil
end)

